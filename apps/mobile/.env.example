# Copy to .env and fill in.
# Local dev: use your Mac's LAN IP (check: ipconfig getifaddr en0) so a phone
# on the same Wi-Fi can reach local Supabase, e.g. http://192.168.x.x:54321
# Hosted values: https://supabase.com/dashboard → your project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Where invite links point (the web app) — Vercel URL in production.
EXPO_PUBLIC_APP_URL=http://localhost:3000
